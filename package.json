{
  "name": "emotion-music",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "基于人脸情绪识别的歌曲推荐系统 (Vue3 + face-api.js + NetEase API)",
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"vite\" \"node server/api.cjs\"",
    "dev:web": "vite",
    "dev:api": "node server/api.cjs",
    "build": "vite build",
    "build:gh": "node scripts/build-gh.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.22.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "vite": "^6.0.7"
  }
}
